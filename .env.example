# Образец настроек для docker compose. Скопировать в .env и заполнить:
#   cp .env.example .env && chmod 600 .env
# Случайные значения удобно получать командой: openssl rand -base64 48

# --- Обязательно заполнить ---

# Длинная случайная строка, никому не показывать.
SECRET_KEY=

# Домен сайта, с www и без, через запятую.
ALLOWED_HOSTS=example.ru,www.example.ru
CSRF_TRUSTED_ORIGINS=https://example.ru,https://www.example.ru

# Неочевидный адрес админки, например studio-7f3k2/.
ADMIN_URL=

# Пароль базы данных: случайная строка без кавычек и пробелов.
POSTGRES_PASSWORD=

# --- Можно оставить как есть ---

POSTGRES_DB=keratin
POSTGRES_USER=keratin

# http на время выпуска сертификата, затем https (см. DEPLOY.md).
NGINX_CONF=http

# Порты на сервере, если стандартные заняты.
HTTP_PORT=80
HTTPS_PORT=443

# Процессы gunicorn и ядра для перекодирования роликов
# (на сервере с одним ядром WORKER_CPUS=0.5).
GUNICORN_WORKERS=3
WORKER_CPUS=1

# Ограничения роликов из админки.
VIDEO_MAX_UPLOAD_MB=500
VIDEO_MAX_SECONDS=180
